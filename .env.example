# Base URL of the WSO2 API Gateway that fronts the transaction monitoring API.
NEXT_PUBLIC_API_BASE_URL=

# Server-side URL of the TM auth backend (login, session, user management).
# When set, /api/auth/* and /api/admin/* are proxied to it (see next.config.ts)
# so the browser sees them as same-origin — avoids needing CORS on that backend
# for local dev (see FRONTEND_INTEGRATION.md).
AUTH_BACKEND_URL=

# Only set this instead if the auth backend is reachable directly from the
# browser and has CORS configured for this app's origin. Mutually exclusive
# with AUTH_BACKEND_URL above — pick one integration path.
NEXT_PUBLIC_AUTH_API_BASE_URL=
